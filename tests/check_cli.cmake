set(args)
set(expected_exit 0)
set(expected_stdout "Usage: seedarc")
set(expected_stderr "")
if(CASE STREQUAL "help")
    set(args --help)
elseif(CASE STREQUAL "short_help")
    set(args -h)
elseif(CASE STREQUAL "help_command")
    set(args help)
elseif(CASE STREQUAL "version")
    set(args --version)
    set(expected_stdout "SeedArc ${SEEDARC_VERSION}\n")
elseif(CASE STREQUAL "missing")
    set(expected_exit 2)
    set(expected_stdout "")
    set(expected_stderr "a command is required")
elseif(CASE STREQUAL "unknown")
    set(args --unknown)
    set(expected_exit 2)
    set(expected_stdout "")
    set(expected_stderr "unknown command or option")
elseif(CASE STREQUAL "extra")
    set(args --version extra)
    set(expected_exit 2)
    set(expected_stdout "")
    set(expected_stderr "unexpected extra arguments")
elseif(CASE MATCHES "^(compress|extract|verify|search|benchmark)$")
    set(args "${CASE}" input -o output)
    set(expected_exit 3)
    set(expected_stdout "")
    set(expected_stderr "command is not implemented yet: ${CASE}")
else()
    message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()

execute_process(COMMAND "${SEEDARC_CLI}" ${args}
    RESULT_VARIABLE actual_exit OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 5)
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "${CASE}: exit ${actual_exit}, expected ${expected_exit}; ${stderr}")
endif()
foreach(stream IN ITEMS stdout stderr)
    if("${expected_${stream}}" STREQUAL "")
        if(NOT "${${stream}}" STREQUAL "")
            message(FATAL_ERROR "${CASE}: unexpected ${stream}: ${${stream}}")
        endif()
    else()
        string(FIND "${${stream}}" "${expected_${stream}}" match)
        if(match EQUAL -1)
            message(FATAL_ERROR "${CASE}: missing expected ${stream}: ${${stream}}")
        endif()
    endif()
endforeach()
