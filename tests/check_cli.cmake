# Runs the CLI once and checks exit code and output; fails with a message otherwise.
function(expect_cli expected_exit expected_stdout expected_stderr)
    execute_process(COMMAND "${SEEDARC_CLI}" ${ARGN}
        RESULT_VARIABLE actual_exit OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${CASE} [${ARGN}]: exit ${actual_exit}, expected ${expected_exit}; ${stderr}")
    endif()
    foreach(stream IN ITEMS stdout stderr)
        if("${expected_${stream}}" STREQUAL "")
            if(NOT "${${stream}}" STREQUAL "")
                message(FATAL_ERROR "${CASE} [${ARGN}]: unexpected ${stream}: ${${stream}}")
            endif()
        else()
            string(FIND "${${stream}}" "${expected_${stream}}" match)
            if(match EQUAL -1)
                message(FATAL_ERROR "${CASE} [${ARGN}]: missing expected ${stream}: ${${stream}}")
            endif()
        endif()
    endforeach()
endfunction()

if(CASE STREQUAL "help")
    expect_cli(0 "seedarc compress <file-or-directory> -o <archive>" "" --help)
elseif(CASE STREQUAL "short_help")
    expect_cli(0 "Usage:" "" -h)
elseif(CASE STREQUAL "help_command")
    expect_cli(0 "Exit codes:" "" help)
elseif(CASE STREQUAL "version")
    expect_cli(0 "SeedArc ${SEEDARC_VERSION}\n" "" --version)
elseif(CASE STREQUAL "missing")
    expect_cli(2 "" "a command is required")
elseif(CASE STREQUAL "unknown")
    expect_cli(2 "" "unknown command or option" --unknown)
elseif(CASE STREQUAL "extra")
    expect_cli(2 "" "unexpected extra arguments" --version extra)
elseif(CASE MATCHES "^(search|benchmark)$")
    expect_cli(3 "" "command is not implemented yet: ${CASE}" "${CASE}" input -o output)
elseif(CASE STREQUAL "compress_usage")
    expect_cli(2 "" "compress requires exactly one input path" compress)
    expect_cli(2 "" "compress requires -o <path>" compress input)
    expect_cli(2 "" "-o requires exactly one path" compress input -o)
    expect_cli(2 "" "-o requires exactly one path" compress input -o a -o b)
    expect_cli(2 "" "unknown option: --fast" compress input --fast -o out)
elseif(CASE STREQUAL "extract_usage")
    expect_cli(2 "" "extract requires -o <path>" extract archive)
    expect_cli(2 "" "extract requires exactly one input path" extract a b -o out)
elseif(CASE STREQUAL "verify_usage")
    expect_cli(2 "" "verify requires exactly one input path" verify)
    expect_cli(2 "" "verify does not take -o" verify archive -o out)
elseif(CASE STREQUAL "verify_missing")
    expect_cli(5 "" "cannot open archive" verify "${WORK}/no-such-archive")
elseif(CASE STREQUAL "round_trip")
    # WORK is a private directory in the build tree, recreated for every run.
    set(work "${WORK}/round-trip")
    file(REMOVE_RECURSE "${work}")
    file(MAKE_DIRECTORY "${work}/in/sub/empty")
    file(WRITE "${work}/in/hello.txt" "hello SeedArc")
    file(WRITE "${work}/in/sub/data.bin" "0123456789abcdef")
    file(WRITE "${work}/in/sub/zero" "")
    expect_cli(0 "compressed: 5 entries, 29 content bytes" "" compress "${work}/in" -o "${work}/a.sarc")
    expect_cli(0 "verified: 5 entries, 29 content bytes" "" verify "${work}/a.sarc")
    expect_cli(0 "extracted: 5 entries, 29 content bytes" "" extract "${work}/a.sarc" -o "${work}/out")
    foreach(name IN ITEMS hello.txt sub/data.bin sub/zero)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${work}/in/${name}" "${work}/out/${name}"
            RESULT_VARIABLE different)
        if(different)
            message(FATAL_ERROR "round_trip: ${name} differs after extraction")
        endif()
    endforeach()
    if(NOT IS_DIRECTORY "${work}/out/sub/empty")
        message(FATAL_ERROR "round_trip: empty directory was not restored")
    endif()
    # Nothing is overwritten.
    expect_cli(5 "" "output name already exists" compress "${work}/in" -o "${work}/a.sarc")
    expect_cli(5 "" "output name already exists" extract "${work}/a.sarc" -o "${work}/out")
    # A damaged archive is a data error and extracts nothing.
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${work}/in/hello.txt" "${work}/not-an-archive.sarc")
    expect_cli(1 "" "archive is shorter than its header" verify "${work}/not-an-archive.sarc")
    expect_cli(1 "" "archive is shorter than its header" extract "${work}/not-an-archive.sarc" -o "${work}/bad-out")
    if(EXISTS "${work}/bad-out")
        message(FATAL_ERROR "round_trip: a rejected archive produced output")
    endif()
    file(GLOB leftovers "${work}/.seedarc-*")
    if(leftovers)
        message(FATAL_ERROR "round_trip: temporaries left behind: ${leftovers}")
    endif()
    file(REMOVE_RECURSE "${work}")
else()
    message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()
