cmake_minimum_required(VERSION 3.28)
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(root "${WORK}/run-${token}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse a fixture directory")
endif()
set(init "${root}/initial")
set(more "${root}/more")
set(all "${root}/all")
foreach(i RANGE 0 9)
    string(REPEAT "function ${i}(x) { return x + ${i}; }\n" 70 body)
    set(rel "group-${i}/文件-${i}.cpp")
    file(WRITE "${init}/${rel}" "${body}")
    file(WRITE "${all}/${rel}" "${body}")
endforeach()
string(REPEAT "alpha beta gamma delta multiblock\n" 6000 big)
file(WRITE "${init}/source/big.txt" "${big}")
file(WRITE "${all}/source/big.txt" "${big}")
file(WRITE "${init}/empty" "")
file(WRITE "${all}/empty" "")
foreach(rel "new/新增.txt" "group-1/next.cpp" "new/empty")
    file(WRITE "${more}/${rel}" "additional alpha beta gamma\n")
    file(WRITE "${all}/${rel}" "additional alpha beta gamma\n")
endforeach()
file(WRITE "${root}/third/unique.txt" "third batch")
function(run expected result)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL expected)
        message(FATAL_ERROR "solid seed ${ARGN}: ${code}, expected ${expected}\n${out}\n${err}")
    endif()
    set(${result} "${out}" PARENT_SCOPE)
endfunction()
run(0 selftest solid-selftest "${all}")
foreach(plan 0x0 0x6 0xb 0x1f)
    foreach(mode seed-solid explicit-solid solid)
        run(0 packed pack ${mode} ${plan} "${init}" "${root}/${mode}-${plan}.sadx" off)
        run(0 ignored verify "${root}/${mode}-${plan}.sadx" "${init}")
    endforeach()
    set(seed "${root}/seed-solid-${plan}.sadx")
    set(explicit "${root}/explicit-solid-${plan}.sadx")
    run(0 compared payload-compare "${seed}" "${explicit}")
    run(0 compared payload-compare "${seed}" "${root}/solid-${plan}.sadx")
    run(0 ignored pack seed-solid ${plan} "${init}" "${root}/again-${plan}.sadx" off)
    file(SHA256 "${seed}" before)
    file(SHA256 "${root}/again-${plan}.sadx" again)
    if(NOT before STREQUAL again)
        message(FATAL_ERROR "non-deterministic solid Seed pack")
    endif()
    foreach(how segment regroup)
        foreach(mode seed-solid explicit-solid)
            run(0 grown append "${root}/${mode}-${plan}.sadx" "${more}" "${root}/${mode}-${plan}-${how}.sadx" ${how})
            run(0 ignored verify "${root}/${mode}-${plan}-${how}.sadx" "${all}")
        endforeach()
        run(0 compared payload-compare "${root}/seed-solid-${plan}-${how}.sadx" "${root}/explicit-solid-${plan}-${how}.sadx")
    endforeach()
    foreach(mode seed-solid explicit-solid)
        run(0 ignored append "${root}/${mode}-${plan}.sadx" "${more}" "${root}/${mode}-${plan}-new.sadx" --plan 0x6)
        run(0 ignored verify "${root}/${mode}-${plan}-new.sadx" "${all}")
    endforeach()
    run(0 compared payload-compare "${root}/seed-solid-${plan}-new.sadx" "${root}/explicit-solid-${plan}-new.sadx")
    file(SHA256 "${seed}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "append modified old archive")
    endif()
endforeach()
foreach(seed 0x1 0x20 0x40 0xffffffff)
    run(2 ignored pack seed-solid ${seed} "${init}" "${root}/invalid-${seed}.sadx" off)
endforeach()
run(1 ignored pack seed-solid 0x0 "${init}" "${root}/bad-red.sadx" file)
run(1 ignored append "${root}/seed-solid-0x0.sadx" "${more}" "${root}/bad-plan.sadx" --plan 0x148)
run(1 ignored partial "${root}/seed-solid-0x0.sadx" "${init}")
run(1 ignored split "${root}/seed-solid-0x0.sadx" 65536 "${root}/unsupported-volumes")
if(EXISTS "${root}/bad-plan.sadx" OR EXISTS "${root}/bad-red.sadx" OR EXISTS "${root}/unsupported-volumes")
    message(FATAL_ERROR "failed operation published an output")
endif()
if(BEFORE_TOOL)
    foreach(mode seed explicit solid)
        set(old "${root}/old-${mode}.sadx")
        set(new "${root}/new-${mode}.sadx")
        execute_process(COMMAND "${BEFORE_TOOL}" pack ${mode} 0x148 "${init}" "${old}" off RESULT_VARIABLE old_code)
        if(NOT old_code EQUAL 0)
            message(FATAL_ERROR "old tool fixture failed")
        endif()
        run(0 ignored pack ${mode} 0x148 "${init}" "${new}" off)
        file(SHA256 "${old}" old_sha)
        file(SHA256 "${new}" new_sha)
        if(NOT old_sha STREQUAL new_sha)
            message(FATAL_ERROR "legacy ${mode} archive bytes changed")
        endif()
        run(0 ignored verify "${old}" "${init}")
        execute_process(COMMAND "${BEFORE_TOOL}" verify "${new}" "${init}" RESULT_VARIABLE old_code)
        if(NOT old_code EQUAL 0)
            message(FATAL_ERROR "old reader rejected new legacy output")
        endif()
    endforeach()
endif()
message(STATUS "solid Seed / explicit / legacy payloads, histories, negative cases and compatibility passed")
# Only the fresh random child created by this invocation; retain on any failure.
cmake_path(IS_PREFIX WORK "${root}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "unexpected fixture cleanup root")
endif()
file(REMOVE_RECURSE "${root}")
