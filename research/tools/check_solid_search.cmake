cmake_minimum_required(VERSION 3.28)
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(root "${WORK}/run-${token}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse search fixture")
endif()
set(input "${root}/input")
foreach(i RANGE 1 10)
    string(REPEAT "function_${i}: alpha beta gamma ${i} 中文\n" 250 text)
    file(WRITE "${input}/source-${i}/文件-${i}.cpp" "${text}")
    file(WRITE "${input}/docs/page-${i}.txt" "${text}")
endforeach()
file(WRITE "${input}/empty" "")
file(GLOB_RECURSE files LIST_DIRECTORIES false "${input}/*")
set(bytes 0)
foreach(path IN LISTS files)
    file(SIZE "${path}" size)
    math(EXPR bytes "${bytes}+${size}")
endforeach()
function(run expected output)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
    if(err MATCHES "ERROR: AddressSanitizer|runtime error:|LeakSanitizer" OR NOT code EQUAL expected)
        message(FATAL_ERROR "solid search ${ARGN}: ${code}, expected ${expected}\n${text}\n${err}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()
foreach(multiple 1 4 29)
    math(EXPR budget "${bytes}*${multiple}")
    foreach(mode seed explicit)
        set(out "${root}/${mode}-${multiple}.sadx")
        run(0 result solid-search ${mode} default "${input}" "${out}" ${budget} 3 enumerate)
        run(0 ignored verify "${out}" "${input}")
        string(JSON spent GET "${result}" budget_spent_bytes)
        string(JSON count GET "${result}" evaluations)
        string(JSON best GET "${result}" best_bytes)
        string(JSON baseline GET "${result}" baseline_bytes)
        if(NOT spent EQUAL budget OR NOT count EQUAL multiple OR best GREATER baseline)
            message(FATAL_ERROR "budget, coverage or strong baseline invariant failed")
        endif()
        set(${mode}_result "${result}")
        set(${mode}_best "${best}")
    endforeach()
    if(NOT seed_best EQUAL explicit_best)
        message(FATAL_ERROR "same space/operator/budget gave different scores")
    endif()
    string(JSON seed_plan GET "${seed_result}" best_plan)
    string(JSON explicit_plan GET "${explicit_result}" best_plan)
    string(JSON seed_trials GET "${seed_result}" evaluated)
    string(JSON explicit_trials GET "${explicit_result}" evaluated)
    if(NOT seed_plan STREQUAL explicit_plan OR NOT seed_trials STREQUAL explicit_trials)
        message(FATAL_ERROR "representations changed candidate set or selected plan")
    endif()
    run(0 ignored payload-compare "${root}/seed-${multiple}.sadx" "${root}/explicit-${multiple}.sadx")
endforeach()
math(EXPR budget "${bytes}*4")
run(0 warm_seed solid-search seed 0x1f "${input}" "${root}/warm-seed.sadx" ${budget} 11 near)
run(0 warm_explicit solid-search explicit 3:8 "${input}" "${root}/warm-explicit.sadx" ${budget} 11 near)
foreach(result IN ITEMS warm_seed warm_explicit)
    string(JSON best GET "${${result}}" best_bytes)
    string(JSON start GET "${${result}}" start_bytes)
    string(JSON baseline GET "${${result}}" baseline_bytes)
    string(JSON first_rule GET "${${result}}" trials 0 plan rule)
    string(JSON first_groups GET "${${result}}" trials 0 plan groups)
    if(best GREATER start OR best GREATER baseline OR NOT first_rule EQUAL 3 OR NOT first_groups EQUAL 8)
        message(FATAL_ERROR "warm start or strong fallback invariant failed")
    endif()
endforeach()
run(0 ignored payload-compare "${root}/warm-seed.sadx" "${root}/warm-explicit.sadx")
run(0 repeated solid-search seed 0x1f "${input}" "${root}/repeat.sadx" ${budget} 11 near)
file(SHA256 "${root}/warm-seed.sadx" a)
file(SHA256 "${root}/repeat.sadx" b)
if(NOT a STREQUAL b)
    message(FATAL_ERROR "search output is not deterministic")
endif()
run(0 ignored pack explicit-solid 0:1 "${input}" "${root}/typed.sadx" off)
run(0 ignored pack explicit-solid 0x0 "${input}" "${root}/shorthand.sadx" off)
file(SHA256 "${root}/typed.sadx" a)
file(SHA256 "${root}/shorthand.sadx" b)
if(NOT a STREQUAL b)
    message(FATAL_ERROR "concrete plan input changed encoding")
endif()
math(EXPR too_small "${bytes}-1")
run(1 ignored solid-search seed default "${input}" "${root}/under.sadx" ${too_small} 3 near)
run(1 ignored solid-search seed 0x1f "${input}" "${root}/under-warm.sadx" ${bytes} 3 near)
run(2 ignored solid-search explicit 0x0 "${input}" "${root}/bad.sadx" ${budget} 3 near)
run(2 ignored solid-search seed 0x40 "${input}" "${root}/bad-seed.sadx" ${budget} 3 near)
foreach(name under under-warm bad bad-seed)
    if(EXISTS "${root}/${name}.sadx")
        message(FATAL_ERROR "failed search published a file")
    endif()
endforeach()
file(WRITE "${root}/all-empty/空" "")
run(0 ignored solid-search seed default "${root}/all-empty" "${root}/empty.sadx" 29 3 enumerate)
run(0 ignored verify "${root}/empty.sadx" "${root}/all-empty")
message(STATUS "solid search budgets, full-domain reference, deterministic outputs and direct-plan equivalence passed")
cmake_path(IS_PREFIX WORK "${root}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "unexpected fixture cleanup root")
endif()
file(REMOVE_RECURSE "${root}")
