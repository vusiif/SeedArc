# Indexed single-file extraction (extract / extract-profile): every file byte for byte, reads stay
# below the archive size with small frames, and every failure publishes nothing.
cmake_minimum_required(VERSION 3.28)
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(root "${WORK}/run-${token}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse fixture reuse")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/bounded_fixture.py" "${root}"
    RESULT_VARIABLE fixture_code)
if(NOT fixture_code EQUAL 0)
    message(FATAL_ERROR "portable fixture creation failed")
endif()
set(first "${root}/first")
set(added "${root}/added")
set(all "${root}/all")
function(run expected output)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
    if(err MATCHES "ERROR: AddressSanitizer|runtime error:|LeakSanitizer" OR NOT code EQUAL expected)
        message(FATAL_ERROR "${ARGN}: exit${code}, expected${expected}\n${text}\n${err}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()
# Binary edits of a copy: flip one byte at OFFSET (negative: from the end) or drop the last byte.
function(damage source target mode offset)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -I -c
        "import sys;d=bytearray(open(sys.argv[1],'rb').read());m=sys.argv[3];o=int(sys.argv[4])\nif m=='flip': d[o]^=1\nelse: d=d[:-1]\nopen(sys.argv[2],'xb').write(d)"
        "${source}" "${target}" "${mode}" "${offset}" RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "damage helper failed")
    endif()
endfunction()
function(expect_empty dir)
    file(GLOB left LIST_DIRECTORIES true "${dir}/*")
    if(left)
        message(FATAL_ERROR "a failed or profiled extraction left output: ${left}")
    endif()
endfunction()

file(GLOB_RECURSE names RELATIVE "${all}" "${all}/*")
list(SORT names)
foreach(cap 4096 1073741824)
    set(base "${root}/${cap}.sadx")
    set(next "${root}/${cap}-next.sadx")
    run(0 ignored bounded-pack seed ${cap} "${first}" "${base}")
    run(0 ignored bounded-append ${cap} "${base}" "${added}" "${next}")
    file(SIZE "${next}" archive_size)
    set(out "${root}/out-${cap}")
    file(MAKE_DIRECTORY "${out}")
    set(i 0)
    foreach(name IN LISTS names)
        run(0 result extract "${next}" "${name}" "${out}" "f-${i}")
        file(SHA256 "${all}/${name}" want)
        file(SHA256 "${out}/f-${i}" got)
        string(JSON decoded GET "${result}" decoded_bytes)
        string(JSON requested GET "${result}" requested_bytes)
        string(JSON read GET "${result}" archive_bytes_read)
        if(NOT want STREQUAL got OR decoded GREATER cap OR decoded LESS requested OR read GREATER archive_size)
            message(FATAL_ERROR "extract ${name} at cap ${cap}: wrong bytes or bounds")
        endif()
        if(cap EQUAL 4096 AND NOT read LESS archive_size)
            message(FATAL_ERROR "indexed extraction read the whole archive")
        endif()
        math(EXPR i "${i}+1")
    endforeach()
    set(profile "${root}/profile-${cap}")
    file(MAKE_DIRECTORY "${profile}")
    run(0 extracted extract-profile "${next}" "${all}" 7 "${profile}")
    run(0 accessed access-profile "${next}" "${all}" 7)
    expect_empty("${profile}")
    string(JSON exact GET "${extracted}" byte_exact)
    string(JSON count GET "${extracted}" sample_count)
    string(JSON access_count GET "${accessed}" sample_count)
    if(NOT exact OR NOT count EQUAL access_count)
        message(FATAL_ERROR "extract profile incomplete")
    endif()
    math(EXPR last "${count}-1")
    foreach(j RANGE 0 ${last})
        string(JSON a GET "${extracted}" samples ${j} path)
        string(JSON b GET "${accessed}" samples ${j} path)
        if(NOT a STREQUAL b)
            message(FATAL_ERROR "extract and access profiles chose different samples")
        endif()
    endforeach()
endforeach()

# Failures publish nothing.
set(next "${root}/1073741824-next.sadx")
set(neg "${root}/negative")
file(MAKE_DIRECTORY "${neg}")
run(1 ignored extract "${next}" "no/such/file" "${neg}" "missing")
run(1 ignored extract "${next}" "exact" "${neg}" "../escape")
run(1 ignored extract "${next}" "exact" "${neg}" "a/b")
expect_empty("${neg}")
if(EXISTS "${root}/escape")
    message(FATAL_ERROR "basename escaped the output directory")
endif()
file(WRITE "${neg}/kept" "keep")
run(1 ignored extract "${next}" "exact" "${neg}" "kept")
file(READ "${neg}/kept" kept)
if(NOT kept STREQUAL "keep")
    message(FATAL_ERROR "an existing output was replaced")
endif()
run(1 ignored extract-profile "${next}" "${all}" 3 "${neg}")
file(REMOVE "${neg}/kept")
run(0 probe extract "${next}" "源-3/文件-3.txt" "${neg}" "probe")
file(REMOVE "${neg}/probe")
string(JSON frame_at GET "${probe}" frame_archive_offset)
string(JSON frame_stored GET "${probe}" frame_stored_bytes)
math(EXPR middle "${frame_at}+${frame_stored}/2")
damage("${next}" "${root}/payload.sadx" flip ${middle})
run(1 ignored extract "${root}/payload.sadx" "源-3/文件-3.txt" "${neg}" "payload")
damage("${next}" "${root}/trailer.sadx" flip -30)
run(1 ignored extract "${root}/trailer.sadx" "exact" "${neg}" "trailer")
damage("${next}" "${root}/header.sadx" flip 20)
run(1 ignored extract "${root}/header.sadx" "exact" "${neg}" "header")
damage("${next}" "${root}/cut.sadx" cut 0)
run(1 ignored extract "${root}/cut.sadx" "exact" "${neg}" "cut")
run(0 ignored pack solid 0x148 "${first}" "${root}/v4.sadx" off)
run(1 ignored extract "${root}/v4.sadx" "exact" "${neg}" "v4")
run(2 ignored extract "${next}" "exact" "${neg}")
run(2 ignored extract-profile "${next}" "${all}" 0 "${neg}")
expect_empty("${neg}")
message(STATUS "indexed extraction: every file exact, bounded reads, samples match, failures publish nothing")
cmake_path(IS_PREFIX WORK "${root}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "unexpected cleanup path")
endif()
file(REMOVE_RECURSE "${root}")
