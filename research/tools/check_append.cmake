# DEV-017: end-to-end checks of seedarc_append_study on a small generated tree.
#   cmake -DTOOL=<seedarc_append_study> -DWORK=<dir> -P check_append.cmake
cmake_minimum_required(VERSION 3.28)
file(REMOVE_RECURSE "${WORK}")
set(init "${WORK}/initial")
set(more "${WORK}/more")
set(all "${WORK}/all")
string(RANDOM LENGTH 3000 RANDOM_SEED 20261115 noise)
set(words "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda")
function(make_file rel content)
    foreach(dir IN ITEMS "${init}" "${all}")
        if(ARGN STREQUAL "more" AND dir STREQUAL "${init}")
            continue()
        endif()
        file(WRITE "${dir}/${rel}" "${content}")
    endforeach()
    if(ARGN STREQUAL "more")
        file(WRITE "${more}/${rel}" "${content}")
    endif()
endfunction()
foreach(i RANGE 1 20)
    string(REPEAT "doc ${i} ${words} section ${i}\n" ${i} body)
    make_file("docs/page${i}.txt" "${body}")
    string(REPEAT "def f${i}(x):\n    return x * ${i}\n" 8 code)
    make_file("src/mod${i}.py" "${code}")
endforeach()
string(REPEAT "${words} ${noise}\n" 40 big)
make_file("src/big.bin" "${big}")
foreach(i RANGE 21 26)
    string(REPEAT "doc ${i} ${words} appended ${i}\n" ${i} body)
    make_file("docs/page${i}.txt" "${body}" more)
endforeach()
make_file("newdir/fresh.cfg" "key=value\n" more)
make_file("src/mod99.py" "def g():\n    return 99\n" more)

function(run expect out_var)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL expect)
        message(FATAL_ERROR "append_study ${ARGN}: exit ${code}, expected ${expect}\n${out}\n${err}")
    endif()
    set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# Plan 0x148: rule dir1, k = 3, D = 64 KiB / 16 KiB / none, T = 64 KiB (G5 r1 Seed layout:
# rule:2 | k-1:3 | 8 x (D:2 | T:1) -> (3-1) << 2 | 2 << 5 | 1 << 8).
set(plan 0x148)
foreach(mode seed explicit solid)
    run(0 packed pack ${mode} ${plan} "${init}" "${WORK}/${mode}-0.sadx")
    run(0 again pack ${mode} ${plan} "${init}" "${WORK}/${mode}-0b.sadx")
    file(SHA256 "${WORK}/${mode}-0.sadx" h0)
    file(SHA256 "${WORK}/${mode}-0b.sadx" h0b)
    if(NOT h0 STREQUAL h0b)
        message(FATAL_ERROR "${mode}: packing is not deterministic")
    endif()
    run(0 grown append "${WORK}/${mode}-0.sadx" "${more}" "${WORK}/${mode}-1.sadx")
    string(JSON prefix GET "${grown}" old_is_prefix)
    if(NOT prefix)
        message(FATAL_ERROR "${mode}: old container is not a prefix of the appended one")
    endif()
    run(0 verified verify "${WORK}/${mode}-1.sadx" "${all}")
    string(JSON gens GET "${verified}" generations)
    if(NOT gens EQUAL 2)
        message(FATAL_ERROR "${mode}: expected 2 generations, got ${gens}")
    endif()
    run(0 peeked peek "${WORK}/${mode}-1.sadx" "${all}" 5)
    run(1 ignored append "${WORK}/${mode}-1.sadx" "${more}" "${WORK}/${mode}-dup.sadx")    # duplicate paths
    run(1 ignored append "${WORK}/${mode}-0.sadx" "${more}" "${WORK}/${mode}-1.sadx")      # no overwrite
    run(1 ignored verify "${WORK}/${mode}-0.sadx" "${all}")                                 # missing files
    string(JSON bytes_${mode} GET "${packed}" container_bytes)
    string(JSON meta_${mode} GET "${packed}" parts group_metadata)
    string(JSON data_${mode} GET "${packed}" parts data)
endforeach()
run(0 regrouped append "${WORK}/solid-0.sadx" "${more}" "${WORK}/solid-1r.sadx" regroup)
string(JSON prefix GET "${regrouped}" old_is_prefix)
if(prefix)
    message(FATAL_ERROR "regroup should write a fresh container")
endif()
run(0 ignored verify "${WORK}/solid-1r.sadx" "${all}")
# Seed metadata (Seed + key table) is smaller than one byte per file; the data is identical.
if(NOT data_seed EQUAL data_explicit OR NOT meta_seed LESS meta_explicit)
    message(FATAL_ERROR "seed vs explicit: data ${data_seed}/${data_explicit}, metadata ${meta_seed}/${meta_explicit}")
endif()
run(2 ignored pack seed 0x41 "${init}" "${WORK}/bad.sadx")  # non-canonical plan (k = 1, rule 1)
if(EXISTS "${WORK}/bad.sadx")
    message(FATAL_ERROR "refused plan wrote a container")
endif()
run(0 selftest selftest "${all}")
string(JSON tried GET "${selftest}" damaged_tried)
string(JSON rejected GET "${selftest}" damaged_rejected)
if(NOT tried EQUAL rejected OR tried LESS 50)
    message(FATAL_ERROR "selftest: ${rejected} of ${tried} damaged containers rejected")
endif()
file(REMOVE_RECURSE "${WORK}")
