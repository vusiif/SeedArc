# drift-probe (research/ideas/append-drift-r0.md): runs on the portable fixture, every variant
# round-trips (the tool fails otherwise), and bad arguments are refused.
cmake_minimum_required(VERSION 3.28)
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(root "${WORK}/run-${token}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse fixture reuse")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/bounded_fixture.py" "${root}"
    RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "portable fixture creation failed")
endif()
execute_process(COMMAND "${TOOL}" drift-probe "${root}/first" "${root}/added" 3
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR err MATCHES "AddressSanitizer|runtime error:|LeakSanitizer")
    message(FATAL_ERROR "drift-probe failed: ${err}")
endif()
string(JSON baseline GET "${out}" baseline_bytes)
string(JSON ideal GET "${out}" ideal_marginal_bytes)
string(JSON count LENGTH "${out}" variants)
string(JSON first_name GET "${out}" variants 0 name)
if(baseline LESS_EQUAL 0 OR count LESS 10 OR NOT first_name STREQUAL "none")
    message(FATAL_ERROR "drift-probe output incomplete: ${out}")
endif()
foreach(args "drift-probe;${root}/first;${root}/added;0" "drift-probe;${root}/first;${root}/added;20"
        "drift-probe;${root}/first")
    execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
    if(code EQUAL 0)
        message(FATAL_ERROR "drift-probe accepted bad arguments: ${args}")
    endif()
endforeach()
message(STATUS "drift-probe: fixture run, round trips and refusals passed")
cmake_path(IS_PREFIX WORK "${root}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "unexpected cleanup path")
endif()
file(REMOVE_RECURSE "${root}")
