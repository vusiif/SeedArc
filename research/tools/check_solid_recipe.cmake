# solid-recipe-r1 (ADR-0006): recipe round trips, label truthfulness, mixed generations, refusals.
cmake_minimum_required(VERSION 3.28)
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(root "${WORK}/run-${token}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse fixture reuse")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
file(MAKE_DIRECTORY "${root}")
foreach(step "bounded_fixture.py;${root}/small" "recipe_fixture.py;big;${root}/big")
    list(POP_FRONT step script)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/${script}" ${step}
        RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "fixture ${script} failed")
    endif()
endforeach()
set(first "${root}/small/first")
set(added "${root}/small/added")
set(all "${root}/small/all")
set(big "${root}/big")
function(run expected output)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
    if(err MATCHES "ERROR: AddressSanitizer|runtime error:|LeakSanitizer" OR NOT code EQUAL expected)
        message(FATAL_ERROR "${ARGN}: exit${code}, expected${expected}\n${text}\n${err}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()
function(no_output path)
    if(EXISTS "${path}")
        message(FATAL_ERROR "a refused command published ${path}")
    endif()
endfunction()

function(same_file left right what)
    file(SHA256 "${left}" l)
    file(SHA256 "${right}" r)
    if(NOT l STREQUAL r)
        message(FATAL_ERROR "${what}: files differ")
    endif()
endfunction()

# 1. Every frame step, both representations, two groupings: round trip and readable label.
foreach(frame whole 16MiB 32MiB 64MiB 128MiB 256MiB)
    foreach(group g1-r0 g2-r1)
        set(recipe "solid/zstd-9/${group}/frame-${frame}")
        foreach(rep seed explicit)
            set(out "${root}/${group}-${frame}-${rep}.sadx")
            run(0 packed recipe-pack ${rep} "${recipe}" "${first}" "${out}")
            run(0 ignored verify "${out}" "${first}")
            run(0 described describe "${out}")
            string(JSON label GET "${described}" generations 0 recipe)
            string(JSON revision GET "${described}" generations 0 mapping_revision)
            string(JSON representation GET "${described}" generations 0 representation)
            if(NOT label STREQUAL recipe OR NOT revision EQUAL 3 OR NOT representation STREQUAL rep)
                message(FATAL_ERROR "describe does not return the written recipe: ${described}")
            endif()
        endforeach()
        run(0 ignored payload-compare "${root}/${group}-${frame}-seed.sadx" "${root}/${group}-${frame}-explicit.sadx")
    endforeach()
endforeach()
# The Seed value names the same recipe as its text form.
run(0 packed recipe-pack seed "solid/zstd-9/g1-r0/frame-16MiB" "${first}" "${root}/text.sadx")
string(JSON seed_value GET "${packed}" recipe_seed)
math(EXPR seed_hex "${seed_value}" OUTPUT_FORMAT HEXADECIMAL)
run(0 ignored recipe-pack seed "${seed_hex}" "${first}" "${root}/hex.sadx")
file(SHA256 "${root}/text.sadx" text_hash)
file(SHA256 "${root}/hex.sadx" hex_hash)
if(NOT text_hash STREQUAL hex_hash)
    message(FATAL_ERROR "Seed value and text form disagree")
endif()
# Other codecs and levels: round trip, readable label, and indexed extraction through the
# codec's own prefix decoder (the 16 MiB step splits the 21 MiB input into two frames).
foreach(codec zstd-1 zstd-19 lzma2-0 lzma2-6 lzma2-9 lzma2-6e)
    set(recipe "solid/${codec}/g1-r0/frame-16MiB")
    run(0 packed recipe-pack seed "${recipe}" "${big}" "${root}/big-${codec}.sadx")
    string(JSON frames GET "${packed}" frame_count)
    run(0 ignored verify "${root}/big-${codec}.sadx" "${big}")
    run(0 described describe "${root}/big-${codec}.sadx")
    string(JSON label GET "${described}" generations 0 recipe)
    if(NOT frames EQUAL 2 OR NOT label STREQUAL recipe)
        message(FATAL_ERROR "${codec}: frames ${frames}, label ${label}")
    endif()
    foreach(name a c)
        run(0 ignored extract "${root}/big-${codec}.sadx" "${name}" "${root}" "${codec}-${name}.out")
        file(SHA256 "${big}/${name}" want)
        file(SHA256 "${root}/${codec}-${name}.out" got)
        if(NOT want STREQUAL got)
            message(FATAL_ERROR "${codec}: extracted ${name} differs")
        endif()
    endforeach()
    run(0 ignored recipe-append "${root}/big-${codec}.sadx" "${added}" "${root}/big-${codec}-next.sadx")
endforeach()
# Damaged LZMA2 payloads must never yield wrong bytes.
run(0 fault payload-fault-profile "${root}/big-lzma2-6.sadx" "${big}")
string(JSON accepted GET "${fault}" wrong_bytes_accepted)
string(JSON cases LENGTH "${fault}" cases)
if(NOT accepted EQUAL 0 OR NOT cases EQUAL 3)
    message(FATAL_ERROR "LZMA2 payload fault profile accepted wrong bytes")
endif()
# Different codecs give different payloads; the same codec at another level may too.
execute_process(COMMAND "${TOOL}" payload-compare "${root}/big-zstd-19.sadx" "${root}/big-lzma2-6.sadx"
    RESULT_VARIABLE differ OUTPUT_QUIET ERROR_QUIET)
if(differ EQUAL 0)
    message(FATAL_ERROR "Zstd and LZMA2 payloads compared equal")
endif()
# LZMA2 extreme (ADR-0007): Seed bit 15 / explicit second-word bit 16; both representations give
# the same payload, the hex Seed names the same recipe, describe marks extreme as declared, and
# append and consolidation keep it.
set(extreme "solid/lzma2-9e/g2-r1/frame-16MiB")
foreach(rep seed explicit)
    run(0 packed recipe-pack ${rep} "${extreme}" "${first}" "${root}/x-${rep}.sadx")
    run(0 ignored verify "${root}/x-${rep}.sadx" "${first}")
    run(0 described describe "${root}/x-${rep}.sadx")
    string(JSON label GET "${described}" generations 0 recipe)
    string(JSON check GET "${described}" generations 0 check)
    if(NOT label STREQUAL extreme OR NOT check MATCHES "level and extreme declared")
        message(FATAL_ERROR "extreme recipe described wrongly: ${described}")
    endif()
endforeach()
run(0 ignored payload-compare "${root}/x-seed.sadx" "${root}/x-explicit.sadx")
run(0 packed recipe-pack seed "${extreme}" "${first}" "${root}/x-text.sadx")
string(JSON x_seed GET "${packed}" recipe_seed)
math(EXPR x_bit "(${x_seed} >> 15) & 1")
math(EXPR x_hex "${x_seed}" OUTPUT_FORMAT HEXADECIMAL)
if(NOT x_bit EQUAL 1)
    message(FATAL_ERROR "extreme Seed ${x_hex} does not set bit 15")
endif()
run(0 ignored recipe-pack seed "${x_hex}" "${first}" "${root}/x-hex.sadx")
file(SHA256 "${root}/x-text.sadx" x_text_hash)
file(SHA256 "${root}/x-hex.sadx" x_hex_hash)
if(NOT x_text_hash STREQUAL x_hex_hash)
    message(FATAL_ERROR "extreme Seed value and text form disagree")
endif()
run(0 appended recipe-append "${root}/x-seed.sadx" "${added}" "${root}/x-next.sadx")
string(JSON kept GET "${appended}" new_generation_recipe)
if(NOT kept STREQUAL extreme)
    message(FATAL_ERROR "recipe-append dropped the extreme flag: ${kept}")
endif()
run(0 ignored verify "${root}/x-next.sadx" "${all}")
run(0 ignored extract "${root}/x-next.sadx" "exact" "${root}" "x-exact.out")
file(SHA256 "${all}/exact" want)
file(SHA256 "${root}/x-exact.out" got)
if(NOT want STREQUAL got)
    message(FATAL_ERROR "extract from an extreme archive failed")
endif()
run(0 ignored consolidate "${root}/x-next.sadx" "${root}/x-one.sadx")
run(0 ignored recipe-pack seed "${extreme}" "${all}" "${root}/x-fresh.sadx")
file(SHA256 "${root}/x-one.sadx" x_one_hash)
file(SHA256 "${root}/x-fresh.sadx" x_fresh_hash)
if(NOT x_one_hash STREQUAL x_fresh_hash)
    message(FATAL_ERROR "consolidating an extreme archive differs from recipe-pack")
endif()
# Records no writer produces: Zstd with extreme (Seed bit 15, explicit bit 16), or a reserved
# bit set (Seed bit 17, explicit bit 18; Seed bit 16 / explicit bit 17 are dedup since ADR-0008). Every reader refuses the record, and extract writes nothing.
run(0 zseed recipe-pack seed "solid/zstd-9/g2-r1/frame-16MiB" "${first}" "${root}/z-seed.sadx")
run(0 ignored recipe-pack explicit "solid/zstd-9/g2-r1/frame-16MiB" "${first}" "${root}/z-explicit.sadx")
string(JSON z_seed GET "${zseed}" recipe_seed)
math(EXPR z_extreme "${z_seed} | 32768")
math(EXPR x_reserved "${x_seed} | 131072")
math(EXPR z_word "1 | 65536")      # frame code 1 (16 MiB), codec 0, extreme
math(EXPR x_word "1 | 256 | 262144") # frame code 1, codec 1, bit 18
foreach(case "z-seed;${z_extreme}" "x-seed;${x_reserved}" "z-explicit;${z_word}" "x-explicit;${x_word}")
    list(GET case 0 source)
    list(GET case 1 value)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -I "${CMAKE_CURRENT_LIST_DIR}/recipe_fixture.py" retag
        "${root}/${source}.sadx" "${root}/bad-${source}.sadx" "${value}" RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "retag helper failed for ${source}")
    endif()
    foreach(args "verify;${root}/bad-${source}.sadx;${first}" "describe;${root}/bad-${source}.sadx")
        execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE err)
        if(NOT code EQUAL 1 OR NOT err MATCHES "bad solid recipe record")
            message(FATAL_ERROR "${args}: exit${code}, ${err}")
        endif()
    endforeach()
    run(1 ignored extract "${root}/bad-${source}.sadx" "a" "${root}" "bad-${source}.out")
    no_output("${root}/bad-${source}.out")
endforeach()

# Whole-file dedup (ADR-0008). Tree p/{a,a2,b,c,d,e0,e1} q/a: a2, d and q/a copy a (7 MiB),
# e0 / e1 are empty. g1-r0 at 16 MiB keeps the greedy boundaries with every size counted:
# [a (a2)] [b c] [(d) e0 e1 (q/a)], so 3 aliases (21 MiB) and frame bytes equal to dup-probe's
# dedup_same_cut. Under g2-r0, q/ is its own group and q/a stays a real copy.
execute_process(COMMAND "${Python3_EXECUTABLE}" -I "${CMAKE_CURRENT_LIST_DIR}/recipe_fixture.py" dedup
    "${root}/dup" "${big}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "dedup fixture failed")
endif()
set(dedup "solid/zstd-9/g1-r0/frame-16MiB/dedup")
foreach(rep seed explicit)
    run(0 packed recipe-pack ${rep} "${dedup}" "${root}/dup" "${root}/d-${rep}.sadx")
    run(0 ignored verify "${root}/d-${rep}.sadx" "${root}/dup")
    run(0 described describe "${root}/d-${rep}.sadx")
    foreach(check "recipe;${dedup}" "alias_files;3" "alias_bytes;22020096" "frames;3")
        list(GET check 0 field)
        list(GET check 1 want)
        string(JSON got GET "${described}" generations 0 ${field})
        if(NOT got STREQUAL want)
            message(FATAL_ERROR "dedup ${rep} ${field}: ${got}, expected ${want}\n${described}")
        endif()
    endforeach()
    string(JSON check GET "${described}" generations 0 check)
    if(NOT check MATCHES "aliases verified against earlier entries" OR NOT check MATCHES "dedup completeness declared")
        message(FATAL_ERROR "dedup check text: ${check}")
    endif()
endforeach()
run(0 ignored payload-compare "${root}/d-seed.sadx" "${root}/d-explicit.sadx")
run(0 packed recipe-pack seed "${dedup}" "${root}/dup" "${root}/d-text.sadx")
string(JSON d_seed GET "${packed}" recipe_seed)
string(JSON d_data GET "${packed}" parts data)
math(EXPR d_bit "(${d_seed} >> 16) & 1")
math(EXPR d_hex "${d_seed}" OUTPUT_FORMAT HEXADECIMAL)
if(NOT d_bit EQUAL 1)
    message(FATAL_ERROR "dedup Seed ${d_hex} does not set bit 16")
endif()
run(0 ignored recipe-pack seed "${d_hex}" "${root}/dup" "${root}/d-hex.sadx")
same_file("${root}/d-text.sadx" "${root}/d-hex.sadx" "dedup Seed value and text form")
run(0 probe dup-probe "${root}/dup" zstd-9 16MiB)
string(JSON same_cut GET "${probe}" dedup_same_cut compressed_bytes)
if(NOT d_data EQUAL same_cut)
    message(FATAL_ERROR "dedup frame bytes ${d_data}, dup-probe dedup_same_cut ${same_cut}")
endif()
run(0 plain recipe-pack seed "solid/zstd-9/g1-r0/frame-16MiB" "${root}/dup" "${root}/d-plain.sadx")
string(JSON plain_data GET "${plain}" parts data)
run(0 described describe "${root}/d-plain.sadx")
string(JSON plain_aliases GET "${described}" generations 0 alias_files)
if(NOT plain_aliases EQUAL 0 OR NOT d_data LESS plain_data)
    message(FATAL_ERROR "dedup did not shrink the frames (${d_data} vs ${plain_data}) or plain has aliases")
endif()
foreach(case "solid/zstd-9/g2-r0/frame-16MiB/dedup;2" "solid/lzma2-6e/g1-r0/frame-whole/dedup;3")
    list(GET case 0 recipe)
    list(GET case 1 want)
    string(MAKE_C_IDENTIFIER "${recipe}" tag)
    run(0 ignored recipe-pack seed "${recipe}" "${root}/dup" "${root}/d-${tag}.sadx")
    run(0 ignored verify "${root}/d-${tag}.sadx" "${root}/dup")
    run(0 described describe "${root}/d-${tag}.sadx")
    string(JSON got GET "${described}" generations 0 alias_files)
    if(NOT got EQUAL want)
        message(FATAL_ERROR "${recipe}: ${got} aliases, expected ${want}")
    endif()
endforeach()
foreach(name p/d q/a p/a2 p/e1)
    string(MAKE_C_IDENTIFIER "${name}" tag)
    run(0 ignored extract "${root}/d-seed.sadx" "${name}" "${root}" "d-${tag}.out")
    file(SHA256 "${root}/dup/${name}" want)
    file(SHA256 "${root}/d-${tag}.out" got)
    if(NOT want STREQUAL got)
        message(FATAL_ERROR "extract of dedup entry ${name} failed")
    endif()
endforeach()
run(0 ignored --jobs 3 recipe-pack seed "${dedup}" "${root}/dup" "${root}/d-j3.sadx")
same_file("${root}/d-seed.sadx" "${root}/d-j3.sadx" "dedup --jobs 3")
# Append keeps dedup within the new generation only (r/a copies a; generation 0 is not searched);
# consolidation re-detects across the whole tree and equals recipe-pack of it.
file(MAKE_DIRECTORY "${root}/dup-add/r" "${root}/dup-all")
file(COPY_FILE "${root}/dup/p/a" "${root}/dup-add/r/a")
file(COPY "${root}/dup/p" "${root}/dup/q" "${root}/dup-add/r" DESTINATION "${root}/dup-all")
run(0 appended recipe-append "${root}/d-seed.sadx" "${root}/dup-add" "${root}/d-next.sadx")
string(JSON kept GET "${appended}" new_generation_recipe)
run(0 described describe "${root}/d-next.sadx")
string(JSON gen1_aliases GET "${described}" generations 1 alias_files)
if(NOT kept STREQUAL dedup OR NOT gen1_aliases EQUAL 0)
    message(FATAL_ERROR "recipe-append with dedup: ${kept}, ${gen1_aliases} aliases in generation 1")
endif()
run(0 ignored verify "${root}/d-next.sadx" "${root}/dup-all")
run(0 ignored consolidate "${root}/d-next.sadx" "${root}/d-one.sadx")
run(0 ignored recipe-pack seed "${dedup}" "${root}/dup-all" "${root}/d-fresh.sadx")
same_file("${root}/d-one.sadx" "${root}/d-fresh.sadx" "consolidating a dedup archive")
run(0 described describe "${root}/d-one.sadx")
string(JSON one_aliases GET "${described}" generations 0 alias_files)
if(NOT one_aliases EQUAL 4)
    message(FATAL_ERROR "consolidated dedup archive has ${one_aliases} aliases, expected 4")
endif()
# Aliases no writer produces are refused: without the dedup bit, pointing at another file's bytes
# or at a later file, across groups and across generations. Extract writes nothing.
math(EXPR d_plain_seed "${d_seed} & 65535")
execute_process(COMMAND "${Python3_EXECUTABLE}" -I "${CMAKE_CURRENT_LIST_DIR}/recipe_fixture.py" retag
    "${root}/d-seed.sadx" "${root}/bad-d-nodedup.sadx" "${d_plain_seed}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "retag helper failed for dedup")
endif()
foreach(case "d-seed;p/d;1;0;wrong" "d-seed;p/a2;1;7340032;later"
        "d-solid_zstd_9_g2_r0_frame_16MiB_dedup;q/a;0;0;group" "d-next;r/a;0;0;generation")
    list(GET case 0 source)
    list(GET case 1 path)
    list(GET case 2 frame)
    list(GET case 3 offset)
    list(GET case 4 name)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -I "${CMAKE_CURRENT_LIST_DIR}/recipe_fixture.py" realias
        "${root}/${source}.sadx" "${root}/bad-d-${name}.sadx" "${path}" ${frame} ${offset} RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "realias helper failed for ${name}")
    endif()
endforeach()
foreach(case "nodedup|do not follow the generation's recipe" "wrong|do not follow the generation's recipe"
        "later|do not follow the generation's recipe" "group|solid strategy and frame group disagree"
        "generation|solid entry outside its frame")
    string(REPLACE "|" ";" case "${case}")
    list(GET case 0 name)
    list(GET case 1 message)
    foreach(args "verify;${root}/bad-d-${name}.sadx;${root}/dup" "describe;${root}/bad-d-${name}.sadx")
        execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE err)
        if(NOT code EQUAL 1 OR NOT err MATCHES "${message}")
            message(FATAL_ERROR "dedup refusal ${name}, ${args}: exit${code}, ${err}")
        endif()
    endforeach()
    run(1 ignored extract "${root}/bad-d-${name}.sadx" "p/a" "${root}" "bad-d-${name}.out")
    no_output("${root}/bad-d-${name}.out")
endforeach()

# Parallel frame encoding (DEV-035): --jobs changes speed and memory, never the bytes. Checked
# on multi-frame (16 MiB step over 21 MiB) and multi-group archives, for pack, append and
# consolidate; bad worker counts are refused and write nothing.
function(same_bytes left right what)
    file(SHA256 "${left}" l)
    file(SHA256 "${right}" r)
    if(NOT l STREQUAL r)
        message(FATAL_ERROR "--jobs changed the bytes: ${what}")
    endif()
endfunction()
foreach(case "solid/zstd-9/g1-r0/frame-16MiB;${big}" "solid/lzma2-6e/g1-r0/frame-16MiB;${big}"
        "solid/lzma2-9e/g2-r1/frame-whole;${first}" "solid/zstd-3/g2-r1/frame-16MiB;${first}")
    list(GET case 0 recipe)
    list(GET case 1 tree)
    string(MAKE_C_IDENTIFIER "${recipe}" tag)
    foreach(jobs 1 2 5)
        run(0 ignored --jobs ${jobs} recipe-pack seed "${recipe}" "${tree}" "${root}/j${jobs}-${tag}.sadx")
    endforeach()
    run(0 ignored recipe-pack seed "${recipe}" "${tree}" "${root}/j-${tag}.sadx")
    foreach(jobs 1 2 5)
        same_bytes("${root}/j-${tag}.sadx" "${root}/j${jobs}-${tag}.sadx" "${recipe} --jobs ${jobs}")
    endforeach()
endforeach()
run(0 ignored recipe-append "${root}/x-seed.sadx" "${added}" "${root}/j-append-1.sadx")
run(0 ignored --jobs 4 recipe-append "${root}/x-seed.sadx" "${added}" "${root}/j-append-4.sadx")
same_bytes("${root}/j-append-1.sadx" "${root}/j-append-4.sadx" "recipe-append")
run(0 ignored consolidate "${root}/j-append-1.sadx" "${root}/j-one-1.sadx" "solid/zstd-9/g2-r1/frame-16MiB")
run(0 ignored --jobs 3 consolidate "${root}/j-append-1.sadx" "${root}/j-one-3.sadx" "solid/zstd-9/g2-r1/frame-16MiB")
same_bytes("${root}/j-one-1.sadx" "${root}/j-one-3.sadx" "consolidate")
foreach(bad 0 17 04 x "")
    run(2 ignored --jobs "${bad}" recipe-pack seed "solid/zstd-9/g1-r0/frame-16MiB" "${first}" "${root}/bad.sadx")
endforeach()
run(2 ignored --jobs)
no_output("${root}/bad.sadx")

# A whole-frame recipe encodes the same frames as the revision-2 writer.
run(0 ignored bounded-pack seed 1073741824 "${first}" "${root}/legacy.sadx")
run(0 ignored payload-compare "${root}/legacy.sadx" "${root}/g1-r0-whole-seed.sadx")

# 2. The label must match the frames: 21 MiB split by the 16 MiB step, or not split.
run(0 split recipe-pack seed "solid/zstd-9/g1-r0/frame-16MiB" "${big}" "${root}/big16.sadx")
run(0 whole recipe-pack seed "solid/zstd-9/g1-r0/frame-whole" "${big}" "${root}/bigwhole.sadx")
string(JSON split_frames GET "${split}" frame_count)
string(JSON whole_frames GET "${whole}" frame_count)
if(NOT split_frames EQUAL 2 OR NOT whole_frames EQUAL 1)
    message(FATAL_ERROR "16 MiB step did not split 21 MiB into two frames")
endif()
run(0 ignored verify "${root}/big16.sadx" "${big}")
run(0 ignored extract "${root}/big16.sadx" "c" "${root}" "c.out")
file(SHA256 "${big}/c" want)
file(SHA256 "${root}/c.out" got)
if(NOT want STREQUAL got)
    message(FATAL_ERROR "extract from a recipe archive failed")
endif()
# Relabel each archive with the other's recipe (CRCs fixed): every reader must refuse.
string(JSON whole_seed GET "${whole}" recipe_seed)
string(JSON split_seed GET "${split}" recipe_seed)
foreach(pair "big16;${whole_seed};lie-whole" "bigwhole;${split_seed};lie-16")
    list(GET pair 0 source)
    list(GET pair 1 value)
    list(GET pair 2 name)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -I "${CMAKE_CURRENT_LIST_DIR}/recipe_fixture.py" retag
        "${root}/${source}.sadx" "${root}/${name}.sadx" "${value}" RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "retag helper failed")
    endif()
    foreach(command verify describe)
        if(command STREQUAL "verify")
            set(args verify "${root}/${name}.sadx" "${big}")
        else()
            set(args describe "${root}/${name}.sadx")
        endif()
        execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE err)
        if(NOT code EQUAL 1 OR NOT err MATCHES "do not follow the generation's recipe")
            message(FATAL_ERROR "${command} of a relabelled archive: exit${code}, ${err}")
        endif()
    endforeach()
    run(1 ignored extract "${root}/${name}.sadx" "a" "${root}" "${name}.out")
    no_output("${root}/${name}.out")
endforeach()

# 3. Generations: keep the last recipe, change it, mix with revision 2.
run(0 appended recipe-append "${root}/g1-r0-32MiB-seed.sadx" "${added}" "${root}/keep.sadx")
string(JSON kept GET "${appended}" new_generation_recipe)
if(NOT kept STREQUAL "solid/zstd-9/g1-r0/frame-32MiB")
    message(FATAL_ERROR "recipe-append without RECIPE did not keep the last recipe")
endif()
run(0 ignored verify "${root}/keep.sadx" "${all}")
run(0 ignored recipe-append "${root}/g1-r0-32MiB-seed.sadx" "${added}" "${root}/change.sadx" "solid/zstd-9/g2-r1/frame-16MiB")
run(0 described describe "${root}/change.sadx")
string(JSON second GET "${described}" generations 1 recipe)
if(NOT second STREQUAL "solid/zstd-9/g2-r1/frame-16MiB")
    message(FATAL_ERROR "new generation recipe not recorded")
endif()
run(0 ignored verify "${root}/change.sadx" "${all}")
run(0 ignored recipe-append "${root}/legacy.sadx" "${added}" "${root}/mixed.sadx" "solid/zstd-9/g1-r0/frame-64MiB")
run(0 described describe "${root}/mixed.sadx")
string(JSON rev0 GET "${described}" generations 0 mapping_revision)
string(JSON rev1 GET "${described}" generations 1 mapping_revision)
string(JSON label0 TYPE "${described}" generations 0 recipe)
if(NOT rev0 EQUAL 2 OR NOT rev1 EQUAL 3 OR NOT label0 STREQUAL "NULL")
    message(FATAL_ERROR "mixed revision description is wrong: ${described}")
endif()
run(0 ignored verify "${root}/mixed.sadx" "${all}")
run(0 ignored recipe-append "${root}/g1-r0-whole-explicit.sadx" "${added}" "${root}/explicit-next.sadx" "solid/zstd-9/g1-r0/frame-16MiB")
run(0 ignored verify "${root}/explicit-next.sadx" "${all}")

# 3b. Consolidation: describe reports the appended share; a one-generation rebuild equals
# recipe-pack of the whole tree byte for byte; check mode writes nothing; refusals.
run(0 described describe "${root}/keep.sadx")
string(JSON gen_count GET "${described}" consolidation generation_count)
string(JSON appended_raw GET "${described}" consolidation appended_raw_bytes)
if(NOT gen_count EQUAL 2 OR appended_raw LESS_EQUAL 0)
    message(FATAL_ERROR "describe consolidation facts wrong: ${described}")
endif()
run(0 checked consolidate-check "${root}/keep.sadx")
string(JSON written GET "${checked}" written)
string(JSON before GET "${checked}" archive_bytes_before)
file(SIZE "${root}/keep.sadx" keep_size)
if(written OR NOT before EQUAL keep_size)
    message(FATAL_ERROR "consolidate-check output wrong: ${checked}")
endif()
foreach(pair "keep;seed;solid/zstd-9/g1-r0/frame-32MiB;" "explicit-next;explicit;solid/zstd-9/g1-r0/frame-16MiB;"
        "mixed;seed;solid/zstd-9/g1-r0/frame-64MiB;" "keep;seed;solid/lzma2-6/g2-r1/frame-16MiB;solid/lzma2-6/g2-r1/frame-16MiB")
    list(GET pair 0 source)
    list(GET pair 1 rep)
    list(GET pair 2 recipe)
    list(GET pair 3 given)
    string(MAKE_C_IDENTIFIER "${source}-${recipe}" tag)
    run(0 consolidated consolidate "${root}/${source}.sadx" "${root}/one-${tag}.sadx" ${given})
    run(0 ignored recipe-pack ${rep} "${recipe}" "${all}" "${root}/fresh-${tag}.sadx")
    file(SHA256 "${root}/one-${tag}.sadx" one_hash)
    file(SHA256 "${root}/fresh-${tag}.sadx" fresh_hash)
    string(JSON label GET "${consolidated}" recipe)
    if(NOT one_hash STREQUAL fresh_hash OR NOT label STREQUAL recipe)
        message(FATAL_ERROR "consolidating ${source} differs from recipe-pack ${recipe}")
    endif()
    run(0 ignored verify "${root}/one-${tag}.sadx" "${all}")
endforeach()
file(SHA256 "${root}/keep.sadx" keep_hash)
run(1 ignored consolidate "${root}/keep.sadx" "${root}/legacy.sadx")
run(1 ignored consolidate "${root}/legacy.sadx" "${root}/bad.sadx")
run(2 ignored consolidate "${root}/keep.sadx" "${root}/bad.sadx" "solid/zstd-20/g1-r0/frame-32MiB")
run(1 ignored consolidate-check "${root}/v4-missing.sadx")
file(SHA256 "${root}/keep.sadx" keep_after)
if(NOT keep_hash STREQUAL keep_after)
    message(FATAL_ERROR "consolidate changed its input")
endif()

# 4. Refusals publish nothing.
# Zstd 0 / 20, LZMA2 10, leading zero, unknown codec, frame 48 MiB, k 9; extreme spellings
# (Zstd, upper case, dash, doubled, without a preset, leading zero, LZMA2 10); Seeds: Zstd 0 with
# extreme, Zstd 9 with extreme, bit 17, frame code 7, codec 2, LZMA2 level 10; dedup spellings
# (doubled, upper case, trailing slash, wrong place, dash).
foreach(bad "solid/zstd-0/g1-r0/frame-32MiB" "solid/zstd-20/g1-r0/frame-32MiB"
        "solid/lzma2-10/g1-r0/frame-32MiB" "solid/zstd-09/g1-r0/frame-32MiB"
        "solid/brotli-5/g1-r0/frame-32MiB" "solid/zstd-9/g1-r0/frame-48MiB"
        "solid/zstd-9/g9-r0/frame-32MiB" "solid/zstd-9/g1-r0/frame-32MiB/"
        "solid/zstd-9e/g1-r0/frame-32MiB" "solid/lzma2-9E/g1-r0/frame-32MiB"
        "solid/lzma2-9-e/g1-r0/frame-32MiB" "solid/lzma2-9ee/g1-r0/frame-32MiB"
        "solid/lzma2-e/g1-r0/frame-32MiB" "solid/lzma2-09e/g1-r0/frame-32MiB"
        "solid/lzma2-10e/g1-r0/frame-32MiB" "solid/zstd-9/g1-r0/frame-32MiB/dedup/dedup"
        "solid/zstd-9/g1-r0/frame-32MiB/Dedup" "solid/zstd-9/g1-r0/frame-32MiB/dedup/"
        "solid/zstd-9/g1-r0/dedup/frame-32MiB" "solid/zstd-9/g1-r0/frame-32MiB-dedup" "0x8000" "0xa400" "0x22500" "0x24e0" "0x2620" "0x2920")
    run(2 ignored recipe-pack seed "${bad}" "${first}" "${root}/bad.sadx")
endforeach()
run(2 ignored recipe-pack other "solid/zstd-9/g1-r0/frame-32MiB" "${first}" "${root}/bad.sadx")
run(1 ignored recipe-append "${root}/legacy.sadx" "${added}" "${root}/bad.sadx")
run(1 ignored bounded-append 67108864 "${root}/g1-r0-32MiB-seed.sadx" "${added}" "${root}/bad.sadx")
run(1 ignored recipe-pack seed "solid/zstd-9/g1-r0/frame-16MiB" "${root}/small/all" "${root}/g1-r0-16MiB-seed.sadx")
no_output("${root}/bad.sadx")
run(1 ignored describe "${root}/missing.sadx")
run(0 ignored pack solid 0x148 "${first}" "${root}/v4.sadx" off)
run(1 ignored describe "${root}/v4.sadx")
message(STATUS "solid-recipe-r1: round trips, truthful labels, generations and refusals passed")
cmake_path(IS_PREFIX WORK "${root}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "unexpected cleanup path")
endif()
file(REMOVE_RECURSE "${root}")
