# DEV-017: end-to-end checks of seedarc_append4_study (research container v4).
#   cmake -DTOOL=<seedarc_append4_study> -DWORK=<dir> -P check_append4.cmake
cmake_minimum_required(VERSION 3.28)
file(REMOVE_RECURSE "${WORK}")
set(init "${WORK}/initial")
set(more "${WORK}/more")
set(all "${WORK}/all")
string(RANDOM LENGTH 3000 RANDOM_SEED 20261115 noise)
set(words "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda")
function(make_file rel content)
    foreach(dir IN ITEMS "${init}" "${all}")
        if(ARGN STREQUAL "more" AND dir STREQUAL "${init}")
            continue()
        endif()
        file(WRITE "${dir}/${rel}" "${content}")
    endforeach()
    if(ARGN STREQUAL "more")
        file(WRITE "${more}/${rel}" "${content}")
    endif()
endfunction()
foreach(i RANGE 1 20)
    string(REPEAT "doc ${i} ${words} section ${i}\n" ${i} body)
    make_file("docs/page${i}.txt" "${body}")
    string(REPEAT "def f${i}(x):\n    return x * ${i}\n" 8 code)
    make_file("src/mod${i}.py" "${code}")
endforeach()
string(REPEAT "${words} ${noise}\n" 40 big)
make_file("src/big.bin" "${big}")
foreach(i RANGE 21 26)
    string(REPEAT "doc ${i} ${words} appended ${i}\n" ${i} body)
    make_file("docs/page${i}.txt" "${body}" more)
endforeach()
make_file("newdir/fresh.cfg" "key=value\n" more)
make_file("src/mod99.py" "def g():\n    return 99\n" more)

function(run expect out_var)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL expect)
        message(FATAL_ERROR "append4_study ${ARGN}: exit ${code}, expected ${expect}\n${out}\n${err}")
    endif()
    set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# Plan 0x148: rule dir1, k = 3, D = 64 KiB / 16 KiB / none, T = 64 KiB. Plan 0x126: rule ext,
# k = 2, D = 16 KiB / 16 KiB (2 | 1 << 2 | 1 << 5 | 1 << 8; a different Seed for an appended
# generation).
set(plan 0x148)
set(plan_b 0x126)
foreach(mode seed explicit solid)
    foreach(red off checkpoint file)
        set(tag "${mode}-${red}")
        run(0 packed pack ${mode} ${plan} "${init}" "${WORK}/${tag}-0.sadx" ${red} 4096)
        run(0 again pack ${mode} ${plan} "${init}" "${WORK}/${tag}-0b.sadx" ${red} 4096)
        file(SHA256 "${WORK}/${tag}-0.sadx" h0)
        file(SHA256 "${WORK}/${tag}-0b.sadx" h0b)
        if(NOT h0 STREQUAL h0b)
            message(FATAL_ERROR "${tag}: packing is not deterministic")
        endif()
        string(JSON chosen GET "${packed}" redundancy)
        string(JSON by GET "${packed}" redundancy_chosen_by)
        if(NOT chosen STREQUAL red OR NOT by STREQUAL "user")
            message(FATAL_ERROR "${tag}: asked for ${red}, got ${chosen} (${by})")
        endif()
        foreach(variant a b)
            if(variant STREQUAL "b")
                set(extra --plan ${plan_b})
            else()
                set(extra "")
            endif()
            set(out "${WORK}/${tag}-1${variant}.sadx")
            run(0 grown append "${WORK}/${tag}-0.sadx" "${more}" "${out}" ${extra})
            string(JSON prefix GET "${grown}" old_is_prefix)
            if(NOT prefix)
                message(FATAL_ERROR "${tag}/${variant}: old container is not a prefix")
            endif()
            run(0 verified verify "${out}" "${all}")
            string(JSON gens GET "${verified}" generations)
            if(NOT gens EQUAL 2)
                message(FATAL_ERROR "${tag}/${variant}: expected 2 generations, got ${gens}")
            endif()
            run(0 peeked peek "${out}" "${all}" 5)
            # Recovery from prefixes: never a wrong file (the tool checks), and with redundancy
            # records everything is back once only the footer is missing.
            run(0 partial partial "${out}" "${all}")
            string(JSON ncuts LENGTH "${partial}" cuts)
            math(EXPR last_cut "${ncuts} - 2")
            string(JSON nearly GET "${partial}" cuts ${last_cut} recovered_files)
            string(JSON input_files GET "${partial}" input_files)
            if(NOT red STREQUAL "off" AND NOT nearly EQUAL input_files)
                message(FATAL_ERROR "${tag}/${variant}: ${nearly} of ${input_files} files without the footer")
            endif()
            if(red STREQUAL "off" AND NOT nearly EQUAL 41)
                message(FATAL_ERROR "${tag}/${variant}: off should recover generation 0 (41 files), got ${nearly}")
            endif()
        endforeach()
        run(1 ignored append "${WORK}/${tag}-1a.sadx" "${more}" "${WORK}/${tag}-dup.sadx")   # duplicate paths
        run(1 ignored append "${WORK}/${tag}-0.sadx" "${more}" "${WORK}/${tag}-1a.sadx")     # no overwrite
        run(1 ignored verify "${WORK}/${tag}-0.sadx" "${all}")                                # missing files
        string(JSON bytes_${tag} GET "${packed}" container_bytes)
        string(JSON meta_${tag} GET "${packed}" parts group_metadata)
        string(JSON data_${tag} GET "${packed}" parts data)
    endforeach()
    # Redundancy costs bytes, never data: same data bytes at every level, off is the smallest.
    if(NOT data_${mode}-off EQUAL data_${mode}-file OR NOT data_${mode}-off EQUAL data_${mode}-checkpoint
       OR NOT bytes_${mode}-off LESS bytes_${mode}-file)
        message(FATAL_ERROR "${mode}: redundancy levels changed the data or did not cost bytes")
    endif()
endforeach()
run(0 regrouped append "${WORK}/solid-file-0.sadx" "${more}" "${WORK}/solid-1r.sadx" regroup)
string(JSON prefix GET "${regrouped}" old_is_prefix)
if(prefix)
    message(FATAL_ERROR "regroup should write a fresh container")
endif()
run(0 ignored verify "${WORK}/solid-1r.sadx" "${all}")
run(1 ignored append "${WORK}/seed-file-0.sadx" "${more}" "${WORK}/seed-1r.sadx" regroup)  # solid only
# Seed metadata (Seed + key table) is smaller than one byte per file; the data is identical.
if(NOT data_seed-off EQUAL data_explicit-off OR NOT meta_seed-off LESS meta_explicit-off)
    message(FATAL_ERROR "seed vs explicit: data ${data_seed-off}/${data_explicit-off}, metadata ${meta_seed-off}/${meta_explicit-off}")
endif()
# The recommendation picks a level and says so; this tree is far below the small-archive limit.
run(0 recommended pack seed ${plan} "${init}" "${WORK}/auto.sadx")
string(JSON by GET "${recommended}" redundancy_chosen_by)
string(JSON chosen GET "${recommended}" redundancy)
if(NOT by STREQUAL "recommendation" OR NOT chosen STREQUAL "off")
    message(FATAL_ERROR "auto: ${chosen} chosen by ${by}")
endif()
run(2 ignored pack seed 0x41 "${init}" "${WORK}/bad.sadx")                  # non-canonical plan
run(2 ignored pack seed ${plan} "${init}" "${WORK}/bad.sadx" sometimes)     # unknown level
run(2 ignored pack seed ${plan} "${init}" "${WORK}/bad.sadx" checkpoint 10) # checkpoint too small
if(EXISTS "${WORK}/bad.sadx")
    message(FATAL_ERROR "refused pack wrote a container")
endif()
# Volumes: split, verify, append (new volume files only), recovery with a volume missing.
foreach(mode seed explicit solid)
    foreach(carry none gen dicts)
        set(vd "${WORK}/vol-${mode}-${carry}")
        run(0 split split "${WORK}/${mode}-file-0.sadx" 4096 "${vd}" ${carry})
        string(JSON nvol GET "${split}" volumes_written)
        if(nvol LESS 2)
            message(FATAL_ERROR "${mode}/${carry}: expected several volumes, got ${nvol}")
        endif()
        run(0 ignored vverify "${vd}" "${init}")
        file(GLOB before "${vd}/*.sadv")
        set(hashes "")
        foreach(f IN LISTS before)
            file(SHA256 "${f}" h)
            list(APPEND hashes "${h}")
        endforeach()
        run(0 vappended vappend "${vd}" "${more}")
        set(i 0)
        foreach(f IN LISTS before)
            file(SHA256 "${f}" h)
            list(GET hashes ${i} was)
            if(NOT h STREQUAL was)
                message(FATAL_ERROR "${mode}/${carry}: vappend changed ${f}")
            endif()
            math(EXPR i "${i} + 1")
        endforeach()
        run(0 ignored vverify "${vd}" "${all}")
        run(0 vp vpartial "${vd}" "${all}")  # the tool refuses any wrong recovered file
        if(carry STREQUAL "dicts" AND NOT mode STREQUAL "solid")
            # With the header, GEN record and dictionaries carried, a missing volume costs only the
            # files with data in it (plus at most one whose record sits at its end).
            string(JSON nmiss LENGTH "${vp}" missing)
            string(JSON input_files GET "${vp}" input_files)
            math(EXPR last "${nmiss} - 1")
            foreach(k RANGE ${last})
                string(JSON got GET "${vp}" missing ${k} recovered_files)
                string(JSON touching GET "${vp}" missing ${k} files_with_data_in_volume)
                math(EXPR lost "${input_files} - ${got} - ${touching}")
                if(lost GREATER 1)
                    message(FATAL_ERROR "${mode}/${carry}: missing volume ${k} lost ${lost} extra files")
                endif()
            endforeach()
        endif()
    endforeach()
endforeach()
run(1 ignored split "${WORK}/seed-file-0.sadx" 4096 "${WORK}/vol-seed-gen")      # directory exists
run(2 ignored split "${WORK}/seed-file-0.sadx" 100 "${WORK}/vol-tiny")            # volume too small
file(MAKE_DIRECTORY "${WORK}/vol-gap")
file(GLOB vols "${WORK}/vol-seed-gen/*.sadv")
foreach(f IN LISTS vols)
    get_filename_component(n "${f}" NAME)
    if(NOT n STREQUAL "vol-00001.sadv")
        file(COPY "${f}" DESTINATION "${WORK}/vol-gap")
    endif()
endforeach()
run(1 ignored vverify "${WORK}/vol-gap" "${all}")             # incomplete set
run(1 ignored vappend "${WORK}/vol-gap" "${more}")            # cannot append to an incomplete set
file(COPY "${WORK}/vol-solid-gen/vol-00001.sadv" DESTINATION "${WORK}/vol-gap")
run(1 ignored vverify "${WORK}/vol-gap" "${all}")             # a volume from another archive
run(0 selftest selftest "${all}")
string(JSON tried GET "${selftest}" damaged_tried)
string(JSON rejected GET "${selftest}" damaged_rejected)
if(NOT tried EQUAL rejected OR tried LESS 200)
    message(FATAL_ERROR "selftest: ${rejected} of ${tried} damaged containers rejected")
endif()
file(REMOVE_RECURSE "${WORK}")
