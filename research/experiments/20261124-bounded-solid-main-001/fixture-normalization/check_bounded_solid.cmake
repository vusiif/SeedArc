cmake_minimum_required(VERSION 3.28)
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(root "${WORK}/run-${token}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse fixture reuse")
endif()
set(first "${root}/first")
set(added "${root}/added")
set(all "${root}/all")
set(hashes "{")
# Native CMake file(WRITE) adds CRLF on Windows; use binary writes for identical test bytes.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/bounded_fixture.py" "${root}"
    RESULT_VARIABLE fixture_code)
if(NOT fixture_code EQUAL 0)
    message(FATAL_ERROR "portable fixture creation failed")
endif()
function(run expected output)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
    if(err MATCHES "ERROR: AddressSanitizer|runtime error:|LeakSanitizer" OR NOT code EQUAL expected)
        message(FATAL_ERROR "${ARGN}: exit${code}, expected${expected}\n${text}\n${err}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()
foreach(cap 4096 8192 1073741824)
    foreach(mode seed explicit)
        set(base "${root}/${cap}-${mode}.sadx")
        set(next "${root}/${cap}-${mode}-next.sadx")
        run(0 packed bounded-pack ${mode} ${cap} "${first}" "${base}")
        run(0 verified verify "${base}" "${first}")
        run(0 appended bounded-append ${cap} "${base}" "${added}" "${next}")
        run(0 verified verify "${next}" "${all}")
        string(JSON maximum GET "${appended}" max_frame_raw_bytes)
        string(JSON old_read GET "${appended}" old_archive_bytes_read)
        string(JSON old_copy GET "${appended}" old_archive_bytes_copied)
        string(JSON old_recompressed GET "${appended}" old_plaintext_bytes_recompressed)
        string(JSON prefix GET "${appended}" old_is_prefix)
        file(SIZE "${base}" old_size)
        if(maximum GREATER cap OR NOT prefix OR NOT old_read EQUAL old_size OR NOT old_copy EQUAL old_size OR NOT old_recompressed EQUAL 0)
            message(FATAL_ERROR "frame cap, prefix or old work accounting failed")
        endif()
        run(0 access access-profile "${next}" "${all}" 7)
        string(JSON count LENGTH "${access}" samples)
        math(EXPR last "${count}-1")
        foreach(j RANGE 0 ${last})
            string(JSON decoded GET "${access}" samples ${j} decoded_bytes)
            if(decoded GREATER cap)
                message(FATAL_ERROR "single file decoded beyond frame cap")
            endif()
        endforeach()
        run(0 fault payload-fault-profile "${next}" "${all}")
        string(JSON accepted GET "${fault}" wrong_bytes_accepted)
        string(JSON cases LENGTH "${fault}" cases)
        if(NOT accepted EQUAL 0 OR NOT cases EQUAL 3)
            message(FATAL_ERROR "payload fault profile is incomplete")
        endif()
        if(BEFORE_TOOL)
            execute_process(COMMAND "${BEFORE_TOOL}" verify "${next}" "${all}" RESULT_VARIABLE before_code OUTPUT_QUIET ERROR_VARIABLE err)
            if(NOT before_code EQUAL 0)
                message(FATAL_ERROR "pre-change reader cannot read bounded frames: ${err}")
            endif()
        endif()
        file(SHA256 "${base}" base_hash)
        file(SHA256 "${next}" next_hash)
        string(APPEND hashes "\"${cap}-${mode}\":\"${base_hash}\",\"${cap}-${mode}-next\":\"${next_hash}\",")
    endforeach()
    run(0 ignored payload-compare "${root}/${cap}-seed.sadx" "${root}/${cap}-explicit.sadx")
    run(0 ignored payload-compare "${root}/${cap}-seed-next.sadx" "${root}/${cap}-explicit-next.sadx")
endforeach()
run(0 ignored pack seed-solid 0x0 "${first}" "${root}/legacy-default.sadx" off)
file(SHA256 "${root}/legacy-default.sadx" default_hash)
file(SHA256 "${root}/1073741824-seed.sadx" limit_hash)
if(NOT default_hash STREQUAL limit_hash)
    message(FATAL_ERROR "default encoder bytes changed")
endif()
if(BEFORE_TOOL)
    execute_process(COMMAND "${BEFORE_TOOL}" pack seed-solid 0x0 "${first}" "${root}/before.sadx" off
        RESULT_VARIABLE before_code OUTPUT_QUIET)
    file(SHA256 "${root}/before.sadx" before_hash)
    if(NOT before_code EQUAL 0 OR NOT before_hash STREQUAL default_hash)
        message(FATAL_ERROR "pre-change default writer bytes changed")
    endif()
endif()
run(1 ignored bounded-pack seed 4095 "${first}" "${root}/oversize.sadx")
run(1 ignored bounded-append 4096 "${root}/1073741824-seed.sadx" "${added}" "${root}/old-oversize.sadx")
run(2 ignored bounded-pack seed 0 "${first}" "${root}/zero.sadx")
foreach(name oversize old-oversize zero)
    if(EXISTS "${root}/${name}.sadx")
        message(FATAL_ERROR "failed command published output")
    endif()
endforeach()
file(WRITE "${root}/all-empty/空" "")
run(0 ignored bounded-pack seed 1 "${root}/all-empty" "${root}/empty.sadx")
run(0 ignored verify "${root}/empty.sadx" "${root}/all-empty")
string(APPEND hashes "\"default\":\"${default_hash}\"}")
if(REPORT)
    file(WRITE "${REPORT}" "${hashes}\n")
endif()
message(STATUS "bounded caps, old readers, default bytes, append, access, faults and negatives passed")
cmake_path(IS_PREFIX WORK "${root}" NORMALIZE owned)
if(NOT owned OR IS_SYMLINK "${root}")
    message(FATAL_ERROR "unexpected cleanup path")
endif()
file(REMOVE_RECURSE "${root}")
